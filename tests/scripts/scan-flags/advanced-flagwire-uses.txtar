# feature: scan-flags
# level: advanced
# tier: 1
# title: flagwire's own gates are flag uses, with keys resolved from the generated constants
# The state is what apply leaves, built from the golden files (no network needed).

fixture shop
cd shop
exec flagwire init
cp $GOLDEN/shop-admin/internal/web/routes.go internal/web/routes.go
cp $GOLDEN/shop-admin/cmd/shop/main.go cmd/shop/main.go
mkdir internal/flags
cp $GOLDEN/flags/admin/flags.go internal/flags/flags.go
cp $GOLDEN/flags/admin/setup.go internal/flags/setup.go
cp ../manifest-admin.json flags.json

exec flagwire scan --json
jsonmatch stdout ../want.json

-- manifest-admin.json --
{
  "$schema": "https://raw.githubusercontent.com/open-feature/cli/refs/heads/main/schema/v0/flag-manifest.json",
  "flags": {
    "admin": {
      "defaultValue": true,
      "description": "Routes under /admin (2 routes)",
      "flagType": "boolean"
    }
  }
}
-- want.json --
{"flags": [
  {"id": "flagwire:admin", "sdk": "flagwire", "key": "admin", "type": "boolean",
   "uses": [{"file": "internal/web/routes.go", "line": 16, "func": "web.Server.Routes"},
            {"file": "internal/web/routes.go", "line": 17, "func": "web.Server.Routes"}]}
]}
