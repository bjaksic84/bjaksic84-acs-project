  "toggles": [
    {"id": "env:ENVMIX_COLOR", "kind": "env", "name": "ENVMIX_COLOR", "boolean": true,
     "reads": [{"file": "main.go", "line": 26, "func": "main.main", "via": "os.LookupEnv"}]},
    {"id": "env:ENVMIX_MODE", "kind": "env", "name": "ENVMIX_MODE", "boolean": true,
     "reads": [{"file": "main.go", "line": 22, "func": "main.main", "via": "os.Getenv"}]},
    {"id": "env:ENVMIX_REGION", "kind": "env", "name": "ENVMIX_REGION", "boolean": false,
     "reads": [{"file": "main.go", "line": 31, "func": "main.main", "via": "os.Getenv"}]},
    {"id": "env:ENVMIX_VERBOSE", "kind": "env", "name": "ENVMIX_VERBOSE", "boolean": true,
     "reads": [{"file": "main.go", "line": 21, "func": "main.main", "via": "os.Getenv"}]},
    {"id": "flag:dry-run", "kind": "cli-flag", "name": "dry-run", "boolean": true,
     "reads": [{"file": "main.go", "line": 14, "func": "main.main", "via": "flag.Bool"}]},
    {"id": "flag:fast", "kind": "cli-flag", "name": "fast", "boolean": true,
     "reads": [{"file": "main.go", "line": 16, "func": "main.main", "via": "flag.BoolVar"}]},
    {"id": "flag:quiet", "kind": "cli-flag", "name": "quiet", "boolean": true,
     "reads": [{"file": "main.go", "line": 18, "func": "main.main", "via": "FlagSet.Bool"}]}
  ]
