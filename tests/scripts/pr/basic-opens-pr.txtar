# feature: pr
# level: basic
# tier: 2
# title: pr pushes the flagwire branch and opens a pull request with the flags table


fixture shop
cd shop
exec flagwire init
gitinit
exec git checkout -q -b flagwire/admin
cp $GOLDEN/shop-admin/internal/web/routes.go internal/web/routes.go
cp $GOLDEN/shop-admin/cmd/shop/main.go cmd/shop/main.go
mkdir internal/flags
cp $GOLDEN/flags/admin/flags.go internal/flags/flags.go
cp $GOLDEN/flags/admin/setup.go internal/flags/setup.go
cp ../manifest-admin.json flags.json
exec git add -A
exec git commit -q -F ../msg-admin.txt
exec git init -q --bare $WORK/remote.git
exec git remote add origin https://github.com/octo/shop.git
exec git remote set-url --push origin $WORK/remote.git
fakegithub
env FLAGWIRE_GITHUB_TOKEN=ghp_test

exec flagwire pr
stdout '^opened https://github\.com/octo/shop/pull/7$'
cmp $WORK/.fakegithub/pull-7.md ../want-body.md

exec git --git-dir=$WORK/remote.git log -1 --format=%s flagwire/admin
stdout '^feat\(flags\): gate admin behind a feature flag$'
exec git rev-parse --abbrev-ref '@{u}'
stdout '^origin/flagwire/admin$'

grep '"authorization":"(Bearer|token) ghp_test"' $FAKEGITHUB_LOG
grep '"base":"main"' $FAKEGITHUB_LOG
grep '"draft":false' $FAKEGITHUB_LOG
grep '"head":"flagwire/admin"' $FAKEGITHUB_LOG
grep '"title":"feat\(flags\): gate admin behind a feature flag"' $FAKEGITHUB_LOG
grep '"path":"/repos/octo/shop/pulls"' $FAKEGITHUB_LOG

-- manifest-admin.json --
{
  "$schema": "https://raw.githubusercontent.com/open-feature/cli/refs/heads/main/schema/v0/flag-manifest.json",
  "flags": {
    "admin": {
      "defaultValue": true,
      "description": "Routes under /admin (2 routes)",
      "flagType": "boolean"
    }
  }
}
-- msg-admin.txt --
feat(flags): gate admin behind a feature flag

Flags: admin
Verified: go build ./... && go vet ./... && go test ./...
Generated-by: flagwire dev
-- want-body.md --
## Feature flags added by flagwire

| Flag | Default | Variable | Sites |
|---|---|---|---|
| `admin` | on | `FLAG_ADMIN` | 2 |

### Sites
- `admin`: `internal/web/routes.go:16`, `internal/web/routes.go:17`

### Switching a flag
Set a flag's variable, for example `FLAG_ADMIN=false`, and restart; or run flagd and set `FLAGWIRE_PROVIDER=ofrep` to switch without a restart. With no value set, a gated flag is on and an adopted flag follows the variable it replaced.

### Verification
go build ./... && go vet ./... && go test ./...

Generated by flagwire dev.
