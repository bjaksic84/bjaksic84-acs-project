# feature: pr
# level: advanced
# tier: 2
# title: flags from every flagwire commit on the branch; title, verification and version from the newest; repo from an SSH URL


fixture shop
cd shop
exec flagwire init
gitinit
exec git checkout -q -b flagwire/admin
cp $GOLDEN/shop-admin/internal/web/routes.go internal/web/routes.go
cp $GOLDEN/shop-admin/cmd/shop/main.go cmd/shop/main.go
mkdir internal/flags
cp $GOLDEN/flags/admin/flags.go internal/flags/flags.go
cp $GOLDEN/flags/admin/setup.go internal/flags/setup.go
cp ../manifest-admin.json flags.json
exec git add -A
exec git commit -q -F ../msg-admin.txt
exec git init -q --bare $WORK/remote.git
cp ../NOTES.md NOTES.md
exec git add NOTES.md
exec git commit -q -m 'docs: add notes'
cp $GOLDEN/shop-recommendations/internal/config/config.go internal/config/config.go
cp $GOLDEN/flags/admin-recommendations/flags.go internal/flags/flags.go
cp $GOLDEN/flags/admin-recommendations/setup.go internal/flags/setup.go
cp ../manifest-two.json flags.json
exec git add -A
exec git commit -q -F ../msg-adopt.txt

exec git remote add origin git@github.com:octo/shop.git
exec git remote set-url --push origin $WORK/remote.git
fakegithub
env FLAGWIRE_GITHUB_TOKEN=ghp_test
exec flagwire pr
stdout '^opened https://github\.com/octo/shop/pull/7$'
cmp $WORK/.fakegithub/pull-7.md ../want-body.md
grep '"method":"GET","path":"/repos/octo/shop"' $FAKEGITHUB_LOG
grep '"title":"feat\(flags\): adopt FEATURE_RECOMMENDATIONS as a feature flag"' $FAKEGITHUB_LOG

-- manifest-admin.json --
{
  "$schema": "https://raw.githubusercontent.com/open-feature/cli/refs/heads/main/schema/v0/flag-manifest.json",
  "flags": {
    "admin": {
      "defaultValue": true,
      "description": "Routes under /admin (2 routes)",
      "flagType": "boolean"
    }
  }
}
-- msg-admin.txt --
feat(flags): gate admin behind a feature flag

Flags: admin
Verified: go build ./... && go vet ./... && go test ./...
Generated-by: flagwire dev
-- NOTES.md --
Notes that have nothing to do with flags.
-- msg-adopt.txt --
feat(flags): adopt FEATURE_RECOMMENDATIONS as a feature flag

Flags: recommendations
Verified: skipped
Generated-by: flagwire 0.3.0
-- manifest-two.json --
{
  "flags": {
    "admin": {"defaultValue": true, "description": "Routes under /admin (2 routes)", "flagType": "boolean"},
    "recommendations": {"defaultValue": false, "description": "Adopted from FEATURE_RECOMMENDATIONS", "flagType": "boolean"}
  }
}
-- want-body.md --
## Feature flags added by flagwire

| Flag | Default | Variable | Sites |
|---|---|---|---|
| `admin` | on | `FLAG_ADMIN` | 2 |
| `recommendations` | off | `FLAG_RECOMMENDATIONS` | 1 |

### Sites
- `admin`: `internal/web/routes.go:16`, `internal/web/routes.go:17`
- `recommendations`: `internal/config/config.go:25`

### Switching a flag
Set a flag's variable, for example `FLAG_ADMIN=false`, and restart; or run flagd and set `FLAGWIRE_PROVIDER=ofrep` to switch without a restart. With no value set, a gated flag is on and an adopted flag follows the variable it replaced.

### Verification
skipped

